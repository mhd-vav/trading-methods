# Copy this to .env and fill in real values. NEVER commit .env.
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Gateway (OpenRouter by default; swap to GapGPT-compatible http endpoint)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY_CODE=
LLM_API_KEY_EVAL=
LLM_REQUEST_TIMEOUT_S=120
LLM_TOTAL_BUDGET_USD=0

# Role overrides: LLM_MODEL_<ROLE_UC>=, LLM_FALLBACK_<ROLE_UC>=
#LLM_MODEL_ORCHESTRATOR=moonshotai/kimi-k2
#LLM_FALLBACK_ORCHESTRATOR=z-ai/glm-5.2

# Security
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

# Observability
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=analysis-api
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Optional dependency probe
REDIS_URL=