{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@trading-desk/contracts": ["../../packages/contracts/src/index.ts"],
      "@trading-desk/chart-core": ["../../packages/chart-core/src/index.ts"],
      "@trading-desk/chart-core/*": ["../../packages/chart-core/src/*"]
    },
    "baseUrl": "."
  },
  "include": ["chart", "lib"],
  "exclude": ["vitest.config.ts", "node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
